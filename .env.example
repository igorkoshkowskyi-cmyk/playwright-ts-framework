# Copy to .env and fill in. This file is the one source of the test environment settings:
# docker compose reads it to start the app and the database, playwright.config.ts loads it
# for the tests. In CI the same variables are set in the workflow instead.

# the published app image from the expense-tracker-app repository
APP_IMAGE=ghcr.io/<your-github-user>/expense-tracker-app:1.0.0

# where the tests reach the app
BASE_URL=http://localhost:3000

# the test database: docker compose creates it with these values, the tests connect with them
DB_HOST=localhost
DB_PORT=5433
DB_NAME=expenses
DB_USER=app
DB_PASSWORD=change-me
