# Copy to .env: the values below work as they are. This file is the one source of the test
# environment settings: docker compose reads it to start the app and the database,
# playwright.config.ts loads it for the tests. In CI the same variables are set in the workflow.

# the published app image from the expense-tracker-app repository; public, no login needed
APP_IMAGE=ghcr.io/igorkoshkowskyi-cmyk/expense-tracker-app:1.0.0

# where the tests reach the app
BASE_URL=http://localhost:3000

# the test database: docker compose creates it with these values, the tests connect with them;
# it lives only in the local container, so any password will do
DB_HOST=localhost
DB_PORT=5433
DB_NAME=expenses
DB_USER=app
DB_PASSWORD=local-test-only
