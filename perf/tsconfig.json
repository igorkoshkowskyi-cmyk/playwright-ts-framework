{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "strict": true,
        "noEmit": true,
        "noUncheckedIndexedAccess": true,
        "allowImportingTsExtensions": true,
        "skipLibCheck": true,
        "types": ["k6"]
    },
    "include": ["./**/*.ts"]
}
